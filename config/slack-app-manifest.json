{
  "display_information": {
    "name": "Director",
    "description": "A private Director inbox and conversation feed for one configured owner",
    "background_color": "#243447"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Director",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "groups:history",
        "groups:read",
        "chat:write",
        "reactions:write",
        "canvases:read",
        "canvases:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "event_subscriptions": {
      "bot_events": [
        "message.groups",
        "app_home_opened"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
